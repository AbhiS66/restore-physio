{
  "name": "restore-physio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate-sitemap.mjs && node scripts/generate-og-image.mjs",
    "build": "npm run generate && node scripts/generate-routes-manifest.js && vite-react-ssg build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:visual": "playwright test tests/color-system.spec.js",
    "test:agentic": "playwright test tests/agentic-browsing.spec.js",
    "test:agentic:full": "playwright test tests/agentic-browsing.spec.js --grep \"Full Agentic Crawl\"",
    "manifest": "node scripts/generate-routes-manifest.js",
    "audit:quick": "node audit-runner.js",
    "preserve": "node scripts/generate-routes-manifest.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.30.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.54.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1",
    "vite-react-ssg": "0.9.2"
  },
  "engines": {
    "node": "22.x"
  }
}